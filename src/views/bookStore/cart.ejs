<h1>Shopping cart</h1>

<% if (viewData && viewData.cartItems && viewData.cartItems.length > 0) { %>
  <div class="table-responsive">
    <table class="table table-striped table-hover">
      <thead class="table-dark">
        <tr>
          <th>ISBN</th>
          <th>Title</th>
          <th>Price</th>
          <th>Quantity</th>
          <th>Total</th>
          <th>Action</th>
        </tr>
      </thead>
      <tbody>
        <% 
          let grandTotal = 0;
          viewData.cartItems.forEach(item => {
            const itemTotal = item.price * item.qty;
            grandTotal += itemTotal;
        %>
          <tr>
            <td><%= item.isbn %></td>
            <td><%= item.title %></td>
            <td>$<%= item.price.toFixed(2) %></td>
            <td><%= item.qty %></td>
            <td>$<%= itemTotal.toFixed(2) %></td>
            <td>
              <form action="<%= baseURL %>books/cart/delete" method="post" class="d-flex gap-2" style="align-items: center;">
                <input type="hidden" name="bookId" value="<%= item.isbn %>">
                <input type="number" name="quantity" min="1" max="<%= item.qty %>" value="1" style="width: 60px;" required>
                <button type="submit" class="btn btn-danger btn-sm">Delete</button>
              </form>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>

  <div class="cart-summary">
    <h4>Total: $<%= grandTotal.toFixed(2) %></h4>
  </div>

  <button class="btn btn-primary btn-lg">Checkout</button>

<% } else { %>
  <p>Your cart is empty.</p>
  <a href="/books" class="btn btn-primary">Continue Shopping</a>
<% } %>
