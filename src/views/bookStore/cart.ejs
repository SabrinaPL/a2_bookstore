<h1>Shopping cart</h1>

<% if (viewData && viewData.cartItems && viewData.cartItems.length > 0) { %>
  <div class="table-responsive">
    <table class="table table-striped table-hover">
      <thead class="table-dark">
        <tr>
          <th>ISBN</th>
          <th>Title</th>
          <th>Price</th>
          <th>Quantity</th>
          <th>Total</th>
          <th>Update item amount</th>
        </tr>
      </thead>
      <tbody>
        <% 
          let grandTotal = 0;
          viewData.cartItems.forEach(item => {
            const itemTotal = item.price * item.qty;
            grandTotal += itemTotal;
        %>
          <tr>
            <td><%= item.isbn %></td>
            <td><%= item.title %></td>
            <td>$<%= item.price.toFixed(2) %></td>
            <td><%= item.qty %></td>
            <td>$<%= itemTotal.toFixed(2) %></td>
            <td>
              <form action="<%= baseURL %>books/cart/update" method="post" class="d-flex gap-2" style="align-items: center;">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="bookId" value="<%= item.isbn %>">
                <input type="number" name="quantity" min="0" value="<%= item.qty %>" style="width: 60px;" required>
                <button type="submit" class="btn btn-warning btn-sm">Update</button>
              </form>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>

  <div class="cart-summary">
    <h4>Total: $<%= grandTotal.toFixed(2) %></h4>
  </div>

  <div class="cart-actions" style="margin-top: 20px; display: flex; justify-content: space-between;">
    <a href="<%= baseURL %>books/checkout" class="btn btn-primary btn-lg">Checkout</a>
    <a href="<%= baseURL %>books/cart/clear" class="btn btn-danger" onclick="return confirm('Are you sure you want to clear your entire cart?');">Clear Cart</a>
  </div>

<% } else { %>
  <p>Your cart is empty.</p>
  <a href="<%= baseURL %>books" class="btn btn-primary">Continue Shopping</a>
<% } %>
