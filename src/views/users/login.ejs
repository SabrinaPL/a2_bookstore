<h1>Log in</h1>

<form class="login-user" method="post" action="<%= baseURL %>users/login">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label for="email">
        Email:
    </label><br>
    <input type="text" id="email" name="email" required><br><br>
    <label for="password">
        Password:
    </label><br>
    <input type="password" id="password" name="password" required><br><br>
    <button type="submit" class="crud-btn">Log in</button>
</form>