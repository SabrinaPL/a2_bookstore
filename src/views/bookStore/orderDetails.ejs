<h1>Order Details</h1>

<% if (viewData && viewData.order) { %>
  <div class="order-details">
    <!-- Invoice Header -->
    <div class="invoice-header">
      <h2>Invoice for Order no. <%= viewData.order.orderNo %></h2>
      <% if (viewData.order.orderDate) { %>
        <p><strong>Order Date:</strong> <%= viewData.order.orderDate %></p>
        <p><strong>Delivery Date:</strong> <%= viewData.order.deliveryDate %></p>
      <% } %>
    </div>

    <!-- Shipping Address -->
    <div class="shipping-address">
      <h3>Shipping Address</h3>
      <p>
        <strong>Name:</strong> <%= viewData.order.customerName %><br>
        <strong>Address:</strong> <%= viewData.order.customerAddress %>
      </p>
    </div>

    <!-- Books Table -->
    <div class="books-section">
      <h3>Books</h3>
      <div class="table-responsive">
        <table class="table table-striped table-hover">
          <thead class="table-dark">
            <tr>
              <th>ISBN</th>
              <th>Title</th>
              <th>Price</th>
              <th>Quantity</th>
              <th>Total</th>
            </tr>
          </thead>
          <tbody>
            <% 
              let orderTotal = 0;
              viewData.order.books.forEach(book => {
                const bookTotal = book.price * book.qty;
                orderTotal += bookTotal;
            %>
              <tr>
                <td><%= book.isbn %></td>
                <td><%= book.title %></td>
                <td>$<%= book.price.toFixed(2) %></td>
                <td><%= book.qty %></td>
                <td>$<%= bookTotal.toFixed(2) %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Order Total -->
    <div class="order-total">
      <h4>Order Total: $<%= (viewData.order.books.reduce((sum, book) => sum + (book.price * book.qty), 0)).toFixed(2) %></h4>
    </div>

    <!-- Action Buttons -->
    <div class="order-actions" style="margin-top: 20px;">
      <a href="<%= baseURL %>books" class="btn btn-primary">Continue Shopping</a>
    </div>
  </div>

<% } else { %>
  <p>No order information available.</p>
  <a href="<%= baseURL %>books" class="btn btn-primary">Back to Books</a>
<% } %>
